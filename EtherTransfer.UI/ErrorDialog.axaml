<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EtherTransfer.UI.ErrorDialog"
        Title="Error"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource AppForeground}"
        CanResize="False">
    <Border Background="{DynamicResource SurfaceBackground}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="24">
            <!-- Header with Icon -->
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
                <PathIcon Data="{StaticResource ErrorIcon}" Width="40" Height="40" Foreground="{DynamicResource DangerColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Error" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Message Card -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" MaxHeight="250">
                <ScrollViewer>
                    <TextBlock Name="MessageText" 
                               Foreground="{DynamicResource AppForeground}"
                               TextWrapping="Wrap" 
                               FontSize="13"
                               LineHeight="20"
                               TextAlignment="Center" />
                </ScrollViewer>
            </Border>

            <!-- Action Button -->
            <Button Grid.Row="2" 
                    Content="OK" 
                    Classes="Primary"
                    Click="Ok_Click" 
                    HorizontalAlignment="Center" 
                    Padding="36,8" 
                    Margin="0,18,0,0" />
        </Grid>
    </Border>
</Window>
