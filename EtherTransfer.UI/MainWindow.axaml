<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
        Width="700" Height="550"
        x:Class="EtherTransfer.UI.MainWindow"
        x:DataType="ui:MainWindow"
        Title="EtherTransfer"
        Background="#1E1E2E"
        Foreground="#CDD6F4">
    <Grid Margin="15" RowDefinitions="Auto,*,Auto,Auto,*">
        <!-- Header -->
        <TextBlock Text="Nearby Devices" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" Grid.Row="0" Foreground="#89B4FA"/>
        
        <!-- Device list -->
        <ListBox x:Name="DevicesList" Grid.Row="1" Background="#313244" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DiscoveredDevices}" Foreground="#CDD6F4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="🖥" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#A6E3A1"/>
                        <TextBlock Text="{Binding Address}" Margin="10,0,0,0" Foreground="#6C7086"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="10">
            <Button Content="Send Files..." x:Name="SendFilesButton" Click="SendFilesButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5"/>
            <Button Content="Send Folder..." x:Name="SendFolderButton" Click="SendFolderButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5"/>
        </StackPanel>
        
        <!-- Debug header -->
        <TextBlock Text="Debug Log" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" Grid.Row="3" Foreground="#F9E2AF"/>
        
        <!-- Debug log -->
        <ListBox x:Name="DebugLogList" Grid.Row="4" Background="#181825" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DebugMessages}" Foreground="#A6ADC8" FontSize="11" FontFamily="Consolas, monospace"/>
    </Grid>
</Window>
