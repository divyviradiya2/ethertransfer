<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        Width="700" Height="650"
        x:Class="EtherTransfer.UI.MainWindow"
        x:DataType="ui:MainWindow"
        Title="EtherTransfer"
        Background="#1E1E2E"
        Foreground="#CDD6F4">
    <Grid Margin="15" RowDefinitions="Auto,Auto,*,Auto,Auto,*,Auto,Auto,Auto,Auto,150">
        
        <!-- Row 0: Header & Profile -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="EtherTransfer" FontWeight="Bold" FontSize="18" Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <TextBox Grid.Column="1" Text="{Binding CustomDeviceName}" Watermark="Custom Device Name" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Save" Click="SaveName_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Row 1: Connected Devices Header -->
        <TextBlock Text="Connected Devices" FontWeight="Bold" FontSize="14" Margin="0,5,0,5" Grid.Row="1" Foreground="#BAC2DE"/>
        
        <!-- Row 2: Device list -->
        <ListBox x:Name="DevicesList" Grid.Row="2" Background="#313244" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DiscoveredDevices}" Foreground="#CDD6F4" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="🖥" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#A6E3A1"/>
                        <TextBlock Text="{Binding Address}" Margin="10,0,0,0" Foreground="#6C7086"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 3: Add Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,5" Spacing="10">
            <!-- Buttons are always enabled now to allow picking files first -->
            <Button Content="Add Files..." x:Name="SendFilesButton" Click="SendFilesButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5"/>
            <Button Content="Add Folder..." x:Name="SendFolderButton" Click="SendFolderButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5"/>
            <Button Content="Clear Selection" x:Name="ClearSelectionButton" Click="ClearSelectionButton_Click" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Padding="15,5" IsVisible="{Binding HasSelectedFiles}"/>
        </StackPanel>

        <!-- Row 4: Review Card Header -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,10,0,5">
            <TextBlock Grid.Column="0" Text="Selected Items" FontWeight="Bold" FontSize="14" Foreground="#BAC2DE" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectionSummaryText}" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Row 5: Review Card ListBox -->
        <ListBox x:Name="SelectedItemsList" Grid.Row="5" Background="#313244" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding SelectedPayloads}" Foreground="#CDD6F4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="5">
                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#89B4FA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="{Binding DisplaySize}" Foreground="#A6ADC8" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding DisplayCount}" Foreground="#6C7086"/>
                        </StackPanel>
                        
                        <Button Grid.Column="3" Content="✕" Click="RemovePayload_Click" CommandParameter="{Binding Id}" Background="Transparent" Foreground="#F38BA8" Padding="5,0" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Row 6: Big SEND Button -->
        <Button Grid.Row="6" Content="SEND TO SELECTED DEVICE" x:Name="ExecuteSendButton" Click="ExecuteSendButton_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,15" Padding="15,10" IsEnabled="{Binding CanSend}"/>

        <!-- Row 7: Progress Bar Overlay (Visible during transfer) -->
        <Border Grid.Row="7" Background="#313244" CornerRadius="5" Padding="15" Margin="0,0,0,10" IsVisible="{Binding IsTransferring}">
            <StackPanel>
                <TextBlock Text="Transferring..." FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding TransferFileName}" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Minimum="0" Maximum="{Binding TransferTotalBytes}" Value="{Binding TransferSentBytes}" Height="15" Margin="0,10"/>
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Text="{Binding TransferProgressText}" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferSpeedText}" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 9: Debug header -->
        <TextBlock Text="Debug Log" FontWeight="Bold" FontSize="14" Margin="0,5,0,5" Grid.Row="9" Foreground="#F9E2AF"/>
        
        <!-- Row 10: Debug log -->
        <ListBox x:Name="DebugLogList" Grid.Row="10" Background="#181825" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DebugMessages}" Foreground="#A6ADC8" FontSize="11" FontFamily="Consolas, monospace"/>
    </Grid>
</Window>
