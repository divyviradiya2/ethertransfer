<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
        Width="850" Height="650"
        x:Class="EtherTransfer.UI.MainWindow"
        x:DataType="ui:MainWindow"
        Title="EtherTransfer"
        Icon="avares://EtherTransfer/Assets/logo.png"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ui:OsToIconConverter x:Key="OsToIconConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.Skeleton">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.2"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.8"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- HEADER / TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="EtherTransfer" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Debug Log Button -->
                <Button Grid.Column="1" Click="ShowDebugLog_Click" Background="Transparent" BorderThickness="0" Margin="15,0,0,0" ToolTip.Tip="See Debug Logs">
                    <PathIcon Data="{StaticResource SettingsIcon}" Width="16" Height="16" Foreground="{DynamicResource AppForegroundSecondary}"/>
                </Button>
                
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Device Name:" Foreground="{DynamicResource AppForegroundSecondary}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Text="{Binding CustomDeviceName}" Width="200" PlaceholderText="Custom Device Name" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="4" Content="Save" Classes="Primary" Click="SaveName_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- MAIN CONTENT (SPLIT LAYOUT) -->
        <Grid Grid.Row="1" ColumnDefinitions="300,1,*" Background="{DynamicResource AppBackground}">
            
            <!-- LEFT PANE: DEVICES -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="15">
                <TextBlock Grid.Row="0" Text="Discovered Devices" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppForegroundSecondary}" Margin="5,0,0,10"/>
                
                <Panel Grid.Row="1" IsVisible="{Binding !IsStartupFatalError}">
                    <!-- Ready State -->
                    <StackPanel IsVisible="{Binding IsReady}">
                        <ListBox x:Name="DevicesList" ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="4" Padding="10">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Image Grid.Column="0" Source="{Binding OS, Converter={StaticResource OsToIconConverter}}" Width="24" Height="24" Margin="0,0,15,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" FontSize="14"/>
                                                <TextBlock Text="{Binding Address}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Empty States (when no devices found) -->
                        <Panel IsVisible="{Binding !DiscoveredDevices.Count}">
                            
                            <!-- VPN Blocked State -->
                            <StackPanel IsVisible="{Binding HasActiveVpn}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20,40,20,20">
                                <PathIcon Data="{StaticResource AlertIcon}" Width="48" Height="48" Foreground="#F9E2AF"/>
                                <TextBlock Text="VPN Blocking Discovery" FontSize="16" Foreground="#F9E2AF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="A Corporate VPN is active. Your IT administrator is likely blocking local network discovery. Please disconnect the VPN." FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Normal Skeleton Loader -->
                            <StackPanel IsVisible="{Binding !HasActiveVpn}" VerticalAlignment="Top" Margin="5,5,5,0" Spacing="30">
                                <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Classes="Skeleton">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="24" Height="24" Margin="0,0,15,0" CornerRadius="12" Background="{DynamicResource AppBorder}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                            <Border Height="14" Width="140" CornerRadius="2" Background="{DynamicResource AppBorder}" HorizontalAlignment="Left" />
                                            <Border Height="10" Width="90" CornerRadius="2" Background="{DynamicResource AppBorder}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="10" Margin="10,0">
                                    <TextBlock Text="Scanning..." FontSize="16" Foreground="{DynamicResource AppForegroundSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Looking for devices connected with ethernet cable." FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </StackPanel>

                    <!-- No Cable State -->
                    <StackPanel IsVisible="{Binding IsNoCable}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
                        <PathIcon Data="{StaticResource AlertIcon}" Width="48" Height="48" Foreground="{DynamicResource AppBorder}"/>
                        <TextBlock Text="No Ethernet cable connected." FontSize="16" Foreground="{DynamicResource AppForegroundSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Please connect both devices directly to each other using an Ethernet cable." FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Configuring State -->
                    <StackPanel IsVisible="{Binding IsConfiguring}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
                        <PathIcon Data="{StaticResource SyncIcon}" Width="48" Height="48" Foreground="{DynamicResource AppBorder}"/>
                        <TextBlock Text="Configuring network..." FontSize="16" Foreground="{DynamicResource AppForegroundSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Assigning link-local address..." FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Error State -->
                    <StackPanel IsVisible="{Binding IsConfigError}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
                        <PathIcon Data="{StaticResource ErrorIcon}" Width="48" Height="48" Foreground="{DynamicResource DangerColor}"/>
                        <TextBlock Text="Configuration Failed" FontSize="16" Foreground="{DynamicResource DangerColor}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LinkErrorMessage}" FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Retry" Classes="Primary" Click="RetryConfig_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Panel>
                
                <!-- Fatal Error State -->
                <StackPanel Grid.Row="1" IsVisible="{Binding IsStartupFatalError}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
                    <PathIcon Data="{StaticResource ErrorIcon}" Width="48" Height="48" Foreground="{DynamicResource DangerColor}"/>
                    <TextBlock Text="Startup Error" FontSize="16" Foreground="{DynamicResource DangerColor}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StartupFatalErrorMessage}" FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            
            <!-- DIVIDER -->
            <Border Grid.Column="1" Background="{DynamicResource AppBorder}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
            <!-- RIGHT PANE: FILES -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="20,15">
                
                <!-- File Actions Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
                    <TextBlock Grid.Column="0" Text="Files to Transfer" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppForegroundSecondary}" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <Button Content="Clear" Classes="Danger" x:Name="ClearSelectionButton" Click="ClearSelectionButton_Click" IsVisible="{Binding HasSelectedFiles}"/>
                        <Button Content="Add Folder" x:Name="SendFolderButton" Click="SendFolderButton_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource FolderIcon}" Width="14" Height="14"/>
                                        <TextBlock Text="Add Folder"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Add Files" x:Name="SendFilesButton" Click="SendFilesButton_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource FileIcon}" Width="14" Height="14"/>
                                        <TextBlock Text="Add Files"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
                
                <!-- File List -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <ListBox x:Name="SelectedItemsList" ItemsSource="{Binding SelectedPayloads}" Background="Transparent" Margin="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                                        <!-- Since Icon is a string in the model, keep it as TextBlock -->
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource AppForeground}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayCount}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="0,2,0,0" IsVisible="{Binding DisplayCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="15,0" VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="3" Classes="Danger" Click="RemovePayload_Click" CommandParameter="{Binding Id}" Padding="6" CornerRadius="4" VerticalAlignment="Center" ToolTip.Tip="Remove">
                                            <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" Foreground="{DynamicResource DangerColor}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Empty State for Files -->
                        <StackPanel IsVisible="{Binding !HasSelectedFiles}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
                            <PathIcon Data="{StaticResource FileIcon}" Width="48" Height="48" Foreground="{DynamicResource AppBorder}"/>
                            <TextBlock Text="No files selected" FontSize="16" Foreground="{DynamicResource AppForegroundSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Add Files' or 'Add Folder' to select items to send." FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Transfer Summary -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding SelectionSummaryText}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Send to Device" x:Name="ExecuteSendButton" Click="ExecuteSendButton_Click" Classes="Primary" FontSize="14" Padding="24,10" IsEnabled="{Binding CanSend}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource SendIcon}" Width="16" Height="16"/>
                                    <TextBlock Text="Send to Device"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
