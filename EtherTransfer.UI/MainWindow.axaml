<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        Width="700" Height="650"
        x:Class="EtherTransfer.UI.MainWindow"
        x:DataType="ui:MainWindow"
        Title="EtherTransfer"
        Background="#1E1E2E"
        Foreground="#CDD6F4">
    <Grid Margin="15" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,150">
        
        <!-- Header -->
        <TextBlock Text="Nearby Devices" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" Grid.Row="0" Foreground="#89B4FA"/>
        
        <!-- Device list -->
        <ListBox x:Name="DevicesList" Grid.Row="1" Background="#313244" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DiscoveredDevices}" Foreground="#CDD6F4" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="🖥" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#A6E3A1"/>
                        <TextBlock Text="{Binding Address}" Margin="10,0,0,0" Foreground="#6C7086"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10" Spacing="10">
            <!-- Ensure button is only enabled when a device is selected -->
            <Button Content="Send Files..." x:Name="SendFilesButton" Click="SendFilesButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5" IsEnabled="{Binding HasSelection}"/>
            <Button Content="Send Folder..." x:Name="SendFolderButton" Click="SendFolderButton_Click" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" BorderThickness="1" Padding="15,5" IsEnabled="{Binding HasSelection}"/>
        </StackPanel>
        
        <!-- Progress Bar Overlay (Visible during transfer) -->
        <Border Grid.Row="3" Background="#313244" CornerRadius="5" Padding="15" Margin="0,0,0,10" IsVisible="{Binding IsTransferring}">
            <StackPanel>
                <TextBlock Text="Transferring..." FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding TransferFileName}" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Minimum="0" Maximum="{Binding TransferTotalBytes}" Value="{Binding TransferSentBytes}" Height="15" Margin="0,10"/>
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Text="{Binding TransferProgressText}" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferSpeedText}" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Incoming Transfer Overlay (Visible when request comes in) -->
        <Border Grid.Row="4" Background="#F38BA8" CornerRadius="5" Padding="15" Margin="0,0,0,10" IsVisible="{Binding HasIncomingRequest}">
            <StackPanel>
                <TextBlock Text="Incoming Transfer Request" FontWeight="Bold" Foreground="#11111B" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding IncomingRequestText}" Foreground="#11111B" Margin="0,0,0,15" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Decline" Click="DeclineTransfer_Click" Background="#11111B" Foreground="#CDD6F4" Padding="15,5"/>
                    <Button Content="Accept" Click="AcceptTransfer_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="15,5"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Debug header -->
        <TextBlock Text="Debug Log" FontWeight="Bold" FontSize="14" Margin="0,5,0,5" Grid.Row="5" Foreground="#F9E2AF"/>
        
        <!-- Debug log -->
        <ListBox x:Name="DebugLogList" Grid.Row="6" Background="#181825" BorderBrush="#45475A" BorderThickness="1" ItemsSource="{Binding DebugMessages}" Foreground="#A6ADC8" FontSize="11" FontFamily="Consolas, monospace"/>
    </Grid>
</Window>
