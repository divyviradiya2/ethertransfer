<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EtherTransfer.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Theme Colors -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundHover" Color="#F0F0F2"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="AppSurface" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#18181B"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#71717A"/>
                    <SolidColorBrush x:Key="AppBorder" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#0284C7"/>
                    <SolidColorBrush x:Key="AccentColorHover" Color="#0369A1"/>
                    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
                    <SolidColorBrush x:Key="DangerBackground" Color="#FEF2F2"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
                    <SolidColorBrush x:Key="SuccessBackground" Color="#ECFDF5"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
                    <SolidColorBrush x:Key="WarningBackground" Color="#FFFBEB"/>
                    
                    <!-- Fluent Theme Overrides -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#F0F0F2"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                </ResourceDictionary>
                <!-- Dark Theme Colors -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#18181B"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#27272A"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundHover" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#202023"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="AppSurface" Color="#202023"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="AppBorder" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="AccentColorHover" Color="#7DD3FC"/>
                    <SolidColorBrush x:Key="AccentForeground" Color="#0F172A"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#F87171"/>
                    <SolidColorBrush x:Key="DangerBackground" Color="#2C1618"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#34D399"/>
                    <SolidColorBrush x:Key="SuccessBackground" Color="#132D22"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="WarningBackground" Color="#2E2413"/>
                    
                    <!-- Fluent Theme Overrides -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#52525B"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Vector Icons -->
            <StreamGeometry x:Key="FolderIcon">M10,4H4C2.9,4,2.01,4.9,2.01,6L2,18C2,19.1,2.9,20,4,20H20C21.1,20,22,19.1,22,18V8C22,6.9,21.1,6,20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="FolderOpenIcon">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21.85C22.69,8 23.33,8.79 23.12,9.6L21.32,16.5C21.05,17.4 20.25,18 19.33,18H18.25L19,20M4,6V18H18.88L20.65,11H4.15L4,6Z</StreamGeometry>
            <StreamGeometry x:Key="FileIcon">M14,2H6C4.9,2,4.01,2.9,4.01,4L4,20C4,21.1,4.89,22,5.99,22H18C19.1,22,20,21.1,20,20V8L14,2M13,9V3.5L18.5,9H13Z</StreamGeometry>
            <StreamGeometry x:Key="SendIcon">M2.01,21L23,12L2.01,3L2,10L17,12L2,14L2.01,21Z</StreamGeometry>
            <StreamGeometry x:Key="DeleteIcon">M6,19C6,20.1,6.9,21,8,21H16C17.1,21,18,20.1,18,19V7H6V19M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z</StreamGeometry>
            <StreamGeometry x:Key="SettingsIcon">M20,19V7H4V19H20M20,3A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5C2,3.89 2.9,3 4,3H20M8.97,8L13.25,12L8.97,16L7.56,14.59L10.41,11.75L7.56,8.91L8.97,8M12,17V15H18V17H12Z</StreamGeometry>
            <StreamGeometry x:Key="WarningIcon">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
            <StreamGeometry x:Key="CheckIcon">M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z</StreamGeometry>
            <StreamGeometry x:Key="CloseIcon">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="AlertIcon">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</StreamGeometry>
            <StreamGeometry x:Key="ErrorIcon">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</StreamGeometry>
            <StreamGeometry x:Key="SyncIcon">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Global Button Style -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>
        
        <!-- Primary Button Style -->
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorHover}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentForeground}"/>
        </Style>
        <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForegroundSecondary}"/>
        </Style>

        <!-- Danger Button Style -->
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>

        <!-- ListBox Style -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppForegroundSecondary}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- ScrollViewer -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <!-- Expander Style Override -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>

    </Application.Styles>
</Application>