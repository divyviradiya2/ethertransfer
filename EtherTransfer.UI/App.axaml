<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EtherTransfer.UI.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundHover" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#09090B"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#374151"/>
                    <SolidColorBrush x:Key="AppBorder" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#0284C7"/>
                    <SolidColorBrush x:Key="AccentColorHover" Color="#0369A1"/>
                    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#DC2626"/>
                    <SolidColorBrush x:Key="DangerBackground" Color="#FEE2E2"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#059669"/>
                    <SolidColorBrush x:Key="SuccessBackground" Color="#D1FAE5"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#B45309"/>
                    <SolidColorBrush x:Key="WarningBackground" Color="#FEF3C7"/>

                    <!-- High-contrast dynamic log brushes for Light Mode -->
                    <SolidColorBrush x:Key="LogDefaultColor" Color="#1F2937"/>
                    <SolidColorBrush x:Key="LogErrorColor" Color="#DC2626"/>
                    <SolidColorBrush x:Key="LogWarningColor" Color="#B45309"/>
                    <SolidColorBrush x:Key="LogSuccessColor" Color="#059669"/>
                    <SolidColorBrush x:Key="LogInfoColor" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="LogSpecialColor" Color="#6D28D9"/>

                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#000000"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#000000"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundHover" Color="#16161A"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#0C0C0E"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#222228"/>
                    <SolidColorBrush x:Key="AppSurface" Color="#0C0C0E"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="AppBorder" Color="#1E1E24"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#0284C7"/>
                    <SolidColorBrush x:Key="AccentColorHover" Color="#0369A1"/>
                    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
                    <SolidColorBrush x:Key="DangerBackground" Color="#241215"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
                    <SolidColorBrush x:Key="SuccessBackground" Color="#0D221A"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
                    <SolidColorBrush x:Key="WarningBackground" Color="#261E10"/>

                    <!-- Vibrant high-contrast dynamic log brushes for Dark Mode -->
                    <SolidColorBrush x:Key="LogDefaultColor" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="LogErrorColor" Color="#F87171"/>
                    <SolidColorBrush x:Key="LogWarningColor" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="LogSuccessColor" Color="#34D399"/>
                    <SolidColorBrush x:Key="LogInfoColor" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="LogSpecialColor" Color="#C084FC"/>

                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#16161A"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#222228"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <StreamGeometry x:Key="FolderIcon">M10,4H4C2.9,4,2.01,4.9,2.01,6L2,18C2,19.1,2.9,20,4,20H20C21.1,20,22,19.1,22,18V8C22,6.9,21.1,6,20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="FolderOpenIcon">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21.85C22.69,8 23.33,8.79 23.12,9.6L21.32,16.5C21.05,17.4 20.25,18 19.33,18H18.25L19,20M4,6V18H18.88L20.65,11H4.15L4,6Z</StreamGeometry>
            <StreamGeometry x:Key="FileIcon">M14,2H6C4.9,2,4.01,2.9,4.01,4L4,20C4,21.1,4.89,22,5.99,22H18C19.1,22,20,21.1,20,20V8L14,2M13,9V3.5L18.5,9H13Z</StreamGeometry>
            <StreamGeometry x:Key="SendIcon">M2.01,21L23,12L2.01,3L2,10L17,12L2,14L2.01,21Z</StreamGeometry>
            <StreamGeometry x:Key="DeleteIcon">M6,19C6,20.1,6.9,21,8,21H16C17.1,21,18,20.1,18,19V7H6V19M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z</StreamGeometry>
            <StreamGeometry x:Key="SettingsIcon">M20,19V7H4V19H20M20,3A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5C2,3.89 2.9,3 4,3H20M8.97,8L13.25,12L8.97,16L7.56,14.59L10.41,11.75L7.56,8.91L8.97,8M12,17V15H18V17H12Z</StreamGeometry>
            <StreamGeometry x:Key="WarningIcon">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
            <StreamGeometry x:Key="CheckIcon">M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z</StreamGeometry>
            <StreamGeometry x:Key="CloseIcon">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="AlertIcon">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</StreamGeometry>
            <StreamGeometry x:Key="ErrorIcon">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</StreamGeometry>
            <StreamGeometry x:Key="SyncIcon">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
            <StreamGeometry x:Key="WindowsIcon">M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z</StreamGeometry>
            <StreamGeometry x:Key="AppleIcon">M18.71,19.5C17.88,20.74 17,21.95 15.66,21.97C14.32,22 13.89,21.18 12.37,21.18C10.84,21.18 10.37,21.95 9.09,22C7.79,22.05 6.8,20.68 5.96,19.47C4.25,17 2.94,12.45 4.7,9.39C5.57,7.87 7.13,6.91 8.82,6.88C10.1,6.86 11.32,7.75 12.11,7.75C12.89,7.75 14.37,6.68 15.92,6.84C16.57,6.87 18.39,7.1 19.56,8.82C19.47,8.88 17.39,10.1 17.41,12.63C17.44,15.65 20.06,16.66 20.09,16.67C20.06,16.74 19.67,18.11 18.71,19.5M15.97,4.72C16.6,3.95 17.03,2.88 16.91,1.81C15.99,1.85 14.86,2.42 14.2,3.19C13.62,3.87 13.11,4.96 13.25,6C14.28,6.08 15.34,5.49 15.97,4.72Z</StreamGeometry>
            <StreamGeometry x:Key="LinuxIcon">M12,2A4,4 0 0,0 8,6C8,7.3 8.6,8.5 9.6,9.2C7.5,10.1 6,12.3 6,15C6,16.5 6.5,17.8 7.3,18.8C6.5,19.5 6,20.5 6,21.5A0.5,0.5 0 0,0 6.5,22H17.5A0.5,0.5 0 0,0 18,21.5C18,20.5 17.5,19.5 16.7,18.8C17.5,17.8 18,16.5 18,15C18,12.3 16.5,10.1 14.4,9.2C15.4,8.5 16,7.3 16,6A4,4 0 0,0 12,2M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4M10.5,5.5A0.5,0.5 0 0,0 10,6A0.5,0.5 0 0,0 10.5,6.5A0.5,0.5 0 0,0 11,6A0.5,0.5 0 0,0 10.5,5.5M13.5,5.5A0.5,0.5 0 0,0 13,6A0.5,0.5 0 0,0 13.5,6.5A0.5,0.5 0 0,0 14,6A0.5,0.5 0 0,0 13.5,5.5M12,7C12.5,7 13,7.2 13,7.5C13,7.8 12.5,8 12,8C11.5,8 11,7.8 11,7.5C11,7.2 11.5,7 12,7Z</StreamGeometry>
            <StreamGeometry x:Key="DeviceGenericIcon">M21,16H3V4H21V16M21,2H3C1.9,2 1,2.9 1,4V16C1,17.1 1.9,18 3,18H10V20H8V22H16V20H14V18H21C22.1,18 23,17.1 23,16V4C23,2.9 22.1,2 21,2Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorHover}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentForeground}"/>
        </Style>
        <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForegroundSecondary}"/>
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppForegroundSecondary}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundHover}"/>
        </Style>

    </Application.Styles>
</Application>