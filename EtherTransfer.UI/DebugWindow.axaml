<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        x:Class="EtherTransfer.UI.DebugWindow"
        x:DataType="ui:MainWindow"
        Title="Developer Logs"
        Icon="avares://EtherTransfer/Assets/logo.ico"
        Width="680" Height="440"
        Background="{DynamicResource SurfaceBackground}"
        Foreground="{DynamicResource AppForeground}"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <TextBlock Grid.Column="0" Text="Developer Logs" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Copy Logs" Click="CopyLog_Click" Classes="Secondary" Padding="14,6" FontSize="12"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <ListBox x:Name="DebugLogList" Background="Transparent" ItemsSource="{Binding DebugMessages}" FontSize="12" FontFamily="Consolas, monospace">
                <ListBox.Styles>
                    <Style Selector="TextBlock.LogDefault">
                        <Setter Property="Foreground" Value="{DynamicResource LogDefaultColor}"/>
                    </Style>
                    <Style Selector="TextBlock.LogError">
                        <Setter Property="Foreground" Value="{DynamicResource LogErrorColor}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style Selector="TextBlock.LogWarning">
                        <Setter Property="Foreground" Value="{DynamicResource LogWarningColor}"/>
                    </Style>
                    <Style Selector="TextBlock.LogSuccess">
                        <Setter Property="Foreground" Value="{DynamicResource LogSuccessColor}"/>
                    </Style>
                    <Style Selector="TextBlock.LogInfo">
                        <Setter Property="Foreground" Value="{DynamicResource LogInfoColor}"/>
                    </Style>
                    <Style Selector="TextBlock.LogSpecial">
                        <Setter Property="Foreground" Value="{DynamicResource LogSpecialColor}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ui:LogMessage">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   Classes.LogError="{Binding IsError}"
                                   Classes.LogWarning="{Binding IsWarning}"
                                   Classes.LogSuccess="{Binding IsSuccess}"
                                   Classes.LogInfo="{Binding IsInfo}"
                                   Classes.LogSpecial="{Binding IsSpecial}"
                                   Classes.LogDefault="{Binding IsDefault}"
                                   Margin="0,0,0,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
