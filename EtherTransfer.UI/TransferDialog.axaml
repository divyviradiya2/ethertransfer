<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EtherTransfer.UI"
        x:Class="EtherTransfer.UI.TransferDialog"
        x:DataType="ui:TransferDialog"
        Title="Transfer Window"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource AppForeground}"
        CanResize="False">
    
    <Border Background="{DynamicResource SurfaceBackground}">
        <Grid Margin="25">
            
            <!-- Sender Mode: Waiting for acceptance -->
            <StackPanel IsVisible="{Binding IsSenderMode}" VerticalAlignment="Center" Spacing="20">
                <TextBlock Text="Awaiting Response" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" TextAlignment="Center"/>
                <TextBlock Text="{Binding WaitingText}" FontSize="14" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                
                <ProgressBar IsIndeterminate="True" Height="4" Margin="20,10" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource AppBorder}" CornerRadius="2"/>
                
                <Button Content="Cancel" Classes="Danger" Click="Cancel_Click" HorizontalAlignment="Center" Padding="24,8"/>
            </StackPanel>
            
            <!-- Receiver Mode: Incoming Request -->
            <StackPanel IsVisible="{Binding IsReceiverMode}" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="Incoming Transfer" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" TextAlignment="Center"/>
                <TextBlock Text="{Binding IncomingRequestText}" FontSize="14" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                
                <StackPanel Spacing="5" Margin="0,5">
                    <TextBlock Text="Save Location:" FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding SavePath}" IsReadOnly="True" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Change" Click="ChangeFolder_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,20,0,0">
                    <Button Content="Decline" Click="Decline_Click" Padding="25,8"/>
                    <Button Content="Accept" Classes="Primary" Click="Accept_Click" Padding="25,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Progress Mode: Transferring Data -->
            <StackPanel IsVisible="{Binding IsProgressMode}" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Transferring" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,15">
                    <TextBlock Text="{Binding TransferFileName}" Foreground="{DynamicResource AppForegroundSecondary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TransferItemCountText}" Foreground="{DynamicResource AppForegroundSecondary}"/>
                </StackPanel>
                
                <ProgressBar Minimum="0" Maximum="{Binding TransferTotalBytes}" Value="{Binding TransferSentBytes}" Height="6" Margin="0,5" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource AppBorder}" CornerRadius="3"/>
                
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,15">
                    <TextBlock Grid.Column="0" Text="{Binding TransferProgressText}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferPercentageText}" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TransferSpeedText}" Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                
                <Button Content="Cancel" Classes="Danger" Click="Cancel_Click" HorizontalAlignment="Center" Padding="24,8"/>
            </StackPanel>

            <!-- Success / Completion Mode -->
            <StackPanel IsVisible="{Binding IsSuccessMode}" VerticalAlignment="Center" Spacing="12">
                <!-- Full Success Header -->
                <StackPanel IsVisible="{Binding IsFullSuccessMode}" Spacing="6">
                    <PathIcon Data="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z" Width="44" Height="44" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Transfer Complete" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding TransferFinalSizeText, StringFormat='{}{0} transferred successfully.'}" FontSize="13" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center"/>
                </StackPanel>
                
                <!-- Partial Success Header (Transfer Cancelled with some saved items) -->
                <StackPanel IsVisible="{Binding IsPartialSuccessMode}" Spacing="6">
                    <PathIcon Data="{StaticResource WarningIcon}" Width="44" Height="44" Foreground="#F9E2AF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Transfer Cancelled" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource AppForeground}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding TransferFinalSizeText}" FontWeight="SemiBold" FontSize="14" Foreground="#F9E2AF" TextAlignment="Center"/>
                    <TextBlock Text="Partial/incomplete files were removed. Completed items are saved:" FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}" TextAlignment="Center"/>
                </StackPanel>
                
                <!-- Transferred items box -->
                <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,8" MaxHeight="130">
                    <ScrollViewer>
                        <TextBlock Text="{Binding CompletedElementsList}" Foreground="{DynamicResource AppForeground}" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                
                <Button Content="Done" Classes="Primary" Click="Done_Click" HorizontalAlignment="Center" Padding="36,8"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
